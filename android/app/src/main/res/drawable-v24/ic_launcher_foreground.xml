<?xml version="1.0" encoding="utf-8"?>
<!--
    Bulk Clock: a barbell laid across a clock face.

    Two details make it read correctly when it is 24 pixels tall. The plates sit
    inboard of the bar ends, leaving short sleeve tips beyond them — that is the
    silhouette the eye reads as "barbell". And the bar is tilted, because a
    horizontal bar between two verticals reads as a capital H instead.

    Drawn on the 108dp adaptive canvas, entirely inside the central 72dp safe
    zone, so no launcher mask can clip it. A vector rather than a PNG so it stays
    sharp at every density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock face: outer circle with the middle punched out. -->
    <path
        android:fillColor="#D4FF3D"
        android:fillType="evenOdd"
        android:pathData="M54,28 a26,26 0 1,1 -0.01,0 Z M54,34.76 a19.24,19.24 0 1,0 0.01,0 Z" />

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-30">
        <!-- Bar, with the sleeve tips reaching past the plates. -->
        <path
            android:fillColor="#D4FF3D"
            android:pathData="M39.8,51.98 h28.4 a1.2,1.2 0 0,1 0,4.04 h-28.4 a1.2,1.2 0 0,1 0,-4.04 Z" />
        <!-- Plates -->
        <path
            android:fillColor="#D4FF3D"
            android:pathData="M43.56,47.07 h3.6 a1.1,1.1 0 0,1 1.1,1.1 v11.66 a1.1,1.1 0 0,1 -1.1,1.1 h-3.6 a1.1,1.1 0 0,1 -1.1,-1.1 v-11.66 a1.1,1.1 0 0,1 1.1,-1.1 Z" />
        <path
            android:fillColor="#D4FF3D"
            android:pathData="M60.84,47.07 h3.6 a1.1,1.1 0 0,1 1.1,1.1 v11.66 a1.1,1.1 0 0,1 -1.1,1.1 h-3.6 a1.1,1.1 0 0,1 -1.1,-1.1 v-11.66 a1.1,1.1 0 0,1 1.1,-1.1 Z" />
    </group>
</vector>
